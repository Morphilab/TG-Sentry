# ============================================================
# tg-sentry — .gitignore (se comparte)
# Solo reglas públicas/compartidas: lo interno del proyecto
# vive en el exclude local, que no se publica.
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Secretos y artefactos locales (NUNCA al repo público)
.env
*.session
*.session-journal
config.toml
logs/
audit/
exports/
runs/
inventory.db
audit.jsonl
plan*.json
export.csv
export.json
coverage.json
.coverage
htmlcov/

# Caches de herramientas
.mypy_cache/
.ruff_cache/
.pytest_cache/

